{
  "name": "3x-ui Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "docker run -d --name 3x-ui -p 2053:2053 --restart unless-stopped crasivo/3x-ui",
  "forwardPorts": [2053],
  "portsAttributes": {
    "2053": {
      "label": "3x-ui Panel",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}